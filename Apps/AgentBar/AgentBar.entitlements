<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Deliberately unsandboxed, and deliberately explicit about it.
	     AgentBar installs hooks by editing ~/.claude/settings.json and
	     ~/.codex/hooks.json, which the App Sandbox forbids. That is also why Mac
	     App Store distribution is a stated non-goal: the app is distributed as
	     source and as an unsigned build instead (ADR-0015). -->
	<key>com.apple.security.app-sandbox</key>
	<false/>

	<!-- com.apple.developer.usernotifications.time-sensitive is deliberately
	     ABSENT, and this is the record of why. It needs no approval from Apple,
	     but it does need a provisioning profile: adding it makes xcodebuild fail
	     with "AgentBar requires a provisioning profile", which would cost a
	     clean checkout its ability to build with no Apple Developer account —
	     the invariant CODE_SIGN_IDENTITY "-" exists to protect. Verified by
	     experiment, 2026-08-19.

	     The notifications still ask for interruptionLevel .timeSensitive. An
	     unentitled app has the level silently downgraded to .active, so the
	     notification is delivered either way and the entitlement is a privilege
	     to be gained rather than a dependency to be met. It belongs to step 13,
	     which introduces Developer ID signing and a profile with it — and which
	     is blocked on an Apple Developer Program membership this project does
	     not have (ADR-0015).

	     com.apple.developer.usernotifications.critical is never requested:
	     that one is for health and safety, which this is not. -->
</dict>
</plist>
